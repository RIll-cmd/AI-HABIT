// This is your Prisma schema file for Ascend OS (SaaS MVP Skeleton)

generator client {
  provider = "prisma-client-js"
}

generator pyclient {
  provider = "prisma-client-py"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  character Character?
}

model Character {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatar    String?
  theme     String?
  title     String?
  level     Int      @default(1)
  exp       Int      @default(0)
  power     Int      @default(0)
  rank      String   @default("F")
  gold      Int      @default(0)
  createdAt DateTime @default(now())

  stats         CharacterStats?
  history       ProgressHistory[]
  habits        Habit[]
  missions      Mission[]
  achievements  CharacterAchievement[]
  economyLogs   EconomyLog[]
  towerProgress FloorProgress[]
  inventory     Inventory[]

  workoutPlans    WorkoutPlan[]
  workoutSessions WorkoutSession[]
  personalRecords PersonalRecord[]
  weeklyBosses    WeeklyBoss[]
}

model CharacterStats {
  id          String    @id @default(uuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  strength    Int @default(1)
  knowledge   Int @default(1)
  discipline  Int @default(1)
  focus       Int @default(1)
  endurance   Int @default(1)
  recovery    Int @default(1)
  consistency Int @default(1)
}

model ProgressHistory {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  type        String
  amount      Int
  description String
  createdAt   DateTime @default(now())
}

model Habit {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String
  difficulty  String // 'Easy', 'Medium', 'Hard'
  primaryStat String // 'strength', 'knowledge', etc.
  isActive    Boolean   @default(true)
  icon        String?
  color       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  schedule HabitSchedule?
  metrics  HabitMetrics?
  missions Mission[]
}

model HabitSchedule {
  id        String    @id @default(uuid())
  habitId   String    @unique
  habit     Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  type      String // 'Daily', 'Weekly', 'Monthly', 'Specific_Days', 'Custom'
  days      String? // JSON array string for specific days
  interval  Int       @default(1)
  startDate DateTime
  endDate   DateTime?
}

model HabitMetrics {
  id                 String @id @default(uuid())
  habitId            String @unique
  habit              Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  habitStrength      Float  @default(100.0)
  successRate        Float  @default(0.0)
  completionRate     Float  @default(0.0)
  currentConsistency Float  @default(0.0)
}

model Mission {
  id             String    @id @default(uuid())
  habitId        String?
  habit          Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  date           DateTime
  status         String    @default("PENDING") // 'PENDING', 'COMPLETED', 'MISSED'
  completionType String? // 'MINI', 'NORMAL', 'ELITE'
  expEarned      Int?
  statsEarned    Int?
  completedAt    DateTime?
}

model Achievement {
  id           String   @id @default(uuid())
  name         String
  description  String
  icon         String?
  rewardType   String // 'GOLD', 'EXP', 'TITLE'
  rewardAmount Int
  condition    String // event triggers like 'MISSIONS_100'
  category     String // 'Habits', 'Workout', 'Social', etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  characterAchievements CharacterAchievement[]
}

model CharacterAchievement {
  id            String      @id @default(uuid())
  characterId   String
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([characterId, achievementId])
}

model EconomyLog {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  currency    String // 'GOLD', 'EXP'
  amount      Int // can be negative for spent gold
  reason      String
  source      String // 'MISSION', 'ACHIEVEMENT', 'SHOP'
  createdAt   DateTime  @default(now())
}

model Tower {
  id          String   @id @default(uuid())
  name        String
  description String
  theme       String
  maxFloor    Int
  createdAt   DateTime @default(now())

  floors Floor[]
}

model Enemy {
  id          String  @id @default(uuid())
  name        String
  type        String // 'Beast', 'Undead', 'Machine', 'Spirit', 'Dragon', 'Titan', 'Shadow', 'Human'
  rarity      String // 'Common', 'Elite', 'Boss', 'Mythic'
  baseHp      Int
  baseAttack  Int
  baseDefense Int
  baseSpeed   Int
  image       String?

  bossFloors Floor[] @relation("FloorBoss")
}

model Floor {
  id               String  @id @default(uuid())
  towerId          String
  tower            Tower   @relation(fields: [towerId], references: [id], onDelete: Cascade)
  floorNumber      Int
  recommendedPower Int
  minStrength      Int     @default(1)
  minKnowledge     Int     @default(1)
  minRecovery      Int     @default(1)
  minDiscipline    Int     @default(1)
  minFocus         Int     @default(1)
  minEndurance     Int     @default(1)
  bossId           String?
  boss             Enemy?  @relation("FloorBoss", fields: [bossId], references: [id], onDelete: SetNull)
  rewardPool       String // JSON-serialized string

  progress FloorProgress[]
}

model FloorProgress {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  floorId     String
  floor       Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  status      String // 'LOCKED', 'UNLOCKED', 'CLEARED', 'PERFECT'
  attempts    Int       @default(0)
  bestTime    Int?
  clearedAt   DateTime?

  @@unique([characterId, floorId])
}

model Item {
  id               String   @id @default(uuid())
  name             String
  description      String
  lore             String?
  category         String // 'Equipment', 'Consumable', 'Material', 'Relic'
  rarity           String // 'Common', 'Uncommon', 'Rare', 'Epic', 'Legendary', 'Mythic', 'Ancient'
  icon             String?
  sellPrice        Int
  buyPrice         Int
  maxStack         Int      @default(1)
  levelRequirement Int      @default(1)
  createdAt        DateTime @default(now())

  equipment      Equipment?
  consumable     Consumable?
  inventoryItems Inventory[]
}

model Equipment {
  id         String  @id @default(uuid())
  itemId     String  @unique
  item       Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  slot       String // 'Weapon', 'Helmet', 'Armor', 'Gloves', 'Boots', 'Ring', 'Necklace', 'Artifact', 'Relic'
  strength   Int     @default(0)
  knowledge  Int     @default(0)
  recovery   Int     @default(0)
  focus      Int     @default(0)
  discipline Int     @default(0)
  endurance  Int     @default(0)
  attack     Int     @default(0)
  defense    Int     @default(0)
  hp         Int     @default(0)
  setName    String?
}

model Consumable {
  id       String @id @default(uuid())
  itemId   String @unique
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  effect   String
  duration Int?
  cooldown Int?
}

model Inventory {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Int       @default(1)
  isEquipped  Boolean   @default(false)
  obtainedAt  DateTime  @default(now())
}

model Exercise {
  id           String   @id @default(uuid())
  name         String   @unique
  category     String   // Chest, Back, Legs, Shoulders, Biceps, Triceps, Core, Cardio, Mobility
  muscleGroup  String
  equipment    String   // Barbell, Dumbbell, Cable, Machine, Bodyweight, Resistance Band
  difficulty   String   // Beginner, Intermediate, Advanced
  description  String?
  instructions String?
  videoUrl     String?
  image        String?
  createdAt    DateTime @default(now())

  exerciseLogs    ExerciseLog[]
  personalRecords PersonalRecord[]
}

model WorkoutPlan {
  id                String   @id @default(uuid())
  characterId       String
  character         Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name              String
  goal              String   // Build Muscle, Strength, Lose Weight, General Fitness
  difficulty        String
  estimatedDuration Int      // Duration in minutes
  createdAt         DateTime @default(now())

  workoutSessions WorkoutSession[]
}

model WorkoutSession {
  id          String       @id @default(uuid())
  characterId String
  character   Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  planId      String?
  plan        WorkoutPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  duration    Int?         // Duration in seconds
  completed   Boolean      @default(false)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?

  exerciseLogs ExerciseLog[]
}

model ExerciseLog {
  id         String         @id @default(uuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  set        Int
  weight     Float
  reps       Int
  rpe        Float?
  restTime   Int?           // Rest time in seconds
  notes      String?
  createdAt  DateTime       @default(now())
}

model PersonalRecord {
  id           String    @id @default(uuid())
  characterId  String
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  weight       Float
  reps         Int
  estimated1RM Float
  date         DateTime  @default(now())
}

model WeeklyBoss {
  id             String    @id @default(uuid())
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name           String
  targetExercise String
  targetWeight   Float
  targetReps     Int
  rewards        String    // JSON-serialized rewards
  isDefeated     Boolean   @default(false)
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
}


