// This is your Prisma schema file for Ascend OS (SaaS MVP Skeleton)

generator client {
  provider = "prisma-client-js"
}

generator pyclient {
  provider = "prisma-client-py"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  character Character?
}

model Character {
  id        String            @id @default(uuid())
  userId    String            @unique
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  avatar    String?
  theme     String?
  title     String?
  level     Int               @default(1)
  exp       Int               @default(0)
  power     Int               @default(0)
  rank      String            @default("F")
  gold      Int               @default(0)
  createdAt DateTime          @default(now())

  stats     CharacterStats?
  history   ProgressHistory[]
}

model CharacterStats {
  id          String    @id @default(uuid())
  characterId String    @unique
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  strength    Int       @default(1)
  knowledge   Int       @default(1)
  discipline  Int       @default(1)
  focus       Int       @default(1)
  endurance   Int       @default(1)
  recovery    Int       @default(1)
  consistency Int       @default(1)
}

model ProgressHistory {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  type        String
  amount      Int
  description String
  createdAt   DateTime  @default(now())
}
