# ==============================================================================
# Ascend OS - Client .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js Build Output
/.next/
/out/

# Production
/build
/dist

# Misc & Keys
.DS_Store
Thumbs.db
*.pem
*.key
*.cert
*.crt

# Debug Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment & Secret Files
.env
.env.local
.env.development
.env.test
.env.production
.env.*
*.env
*.env.*
!.env.example
!*.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Impeccable Tooling Caches
.impeccable/
.impeccable-live/
.impeccable-live.json
